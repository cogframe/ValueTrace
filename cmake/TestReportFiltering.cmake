function(run_trace output_var)
    execute_process(COMMAND "${PROGRAM}" trace "${INPUT}" --function risk_cases --param 0 --up 0 --down 0 ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "trace failed: ${result}\n${output}\n${error}")
    endif()
    set(${output_var} "${output}" PARENT_SCOPE)
endfunction()

run_trace(default_output)
string(REGEX MATCH "Arithmetic report summary: total=([0-9]+) shown=0 hidden=([0-9]+)" summary "${default_output}")
if(NOT summary OR CMAKE_MATCH_1 EQUAL 0 OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Default level 2 did not preserve hidden candidates: ${default_output}")
endif()
set(total "${CMAKE_MATCH_1}")
if(default_output MATCHES "Warning: ArithmeticRisk")
    message(FATAL_ERROR "Default filter printed unverified candidates")
endif()
foreach(filter IN ITEMS 1 2 3)
    run_trace(output --report-level ${filter})
    if(NOT output MATCHES "total=${total} shown=0 hidden=${total}" OR output MATCHES "Warning: ArithmeticRisk")
        message(FATAL_ERROR "Level ${filter} changed analysis or fabricated verified results: ${output}")
    endif()
endforeach()
foreach(filter IN ITEMS 4 5)
    run_trace(output --report-level ${filter})
    if(NOT output MATCHES "total=${total} shown=${total} hidden=0" OR NOT output MATCHES "feasibility=unverified status=unverified")
        message(FATAL_ERROR "Level ${filter} lost unverified warnings: ${output}")
    endif()
endforeach()
run_trace(output --show-status unverified)
if(NOT output MATCHES "total=${total} shown=${total} hidden=0")
    message(FATAL_ERROR "Explicit unverified filter failed: ${output}")
endif()
run_trace(output --show-status none)
if(NOT output MATCHES "total=${total} shown=0 hidden=${total}" OR output MATCHES "Warning: ArithmeticRisk")
    message(FATAL_ERROR "None filter discarded hidden count: ${output}")
endif()
foreach(options IN ITEMS "--report-level;0" "--report-level;6" "--report-level;bad" "--show-status;bogus"
                         "--report-level;4;--show-status;unverified" "--report-level;4;--report-level;5")
    execute_process(COMMAND "${PROGRAM}" trace "${INPUT}" --function risk_cases --param 0 ${options}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "Invalid filter must be rejected: ${options}\n${output}\n${error}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" solve "${INPUT}" --function risk_cases --param 0 --op eq --value 1 --report-level 1
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 2 OR NOT error MATCHES "independent SAT/UNSAT/UNKNOWN")
    message(FATAL_ERROR "Risk report settings must not hide target-value solver results: ${result}\n${output}\n${error}")
endif()
