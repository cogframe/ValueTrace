function(run expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL expected)
        message(FATAL_ERROR "Unexpected CLI result ${code}, expected ${expected}: ${output}\n${error}")
    endif()
    set(actual "${output}\n${error}" PARENT_SCOPE)
endfunction()
run(0 trace "${FIXTURES}/safe" --function CrossB --param-name value --up 1 --down 1)
if(NOT actual MATCHES "LLVM inputs: 3" OR NOT actual MATCHES "CrossA:" OR NOT actual MATCHES "CrossC:" OR
   NOT actual MATCHES "b.cpp:")
    message(FATAL_ERROR "Directory trace did not link source units: ${actual}")
endif()
run(0 verify "${FIXTURES}/safe/c.ll" --input "${FIXTURES}/safe/a.ll" --input "${FIXTURES}/safe/b.bc"
    --function CrossB --param-name value --up 1 --down 1 --report-level 5)
if(NOT actual MATCHES "reason=UnsignedWrap feasibility=scoped-unreachable")
    message(FATAL_ERROR "Mixed input flags lost upstream guard: ${actual}")
endif()
run(0 solve "${FIXTURES}/unsafe" --function CrossC --param-name length --up 2 --op ugt --value 4096)
if(NOT actual MATCHES "SAT" OR NOT actual MATCHES "Boundary input")
    message(FATAL_ERROR "Directory solve missing witness: ${actual}")
endif()
run(0 inspect --input "${FIXTURES}/safe" --function localStep)
if(NOT actual MATCHES "a.cpp:" OR NOT actual MATCHES "b.cpp:" OR NOT actual MATCHES "input=")
    message(FATAL_ERROR "Static candidates missing file identities: ${actual}")
endif()
run(0 trace "${FIXTURES}/safe" --function localStep --function-choice 2 --param-name value --up 1 --down 0)
if(NOT actual MATCHES "Selected localStep")
    message(FATAL_ERROR "Cannot select static candidate: ${actual}")
endif()
run(0 verify "${FIXTURES}/safe" --function CrossAfter --param-name value --up 0 --down 0 --show-status none)
if(NOT actual MATCHES "status=unknown total=2 shown=0 hidden=2" OR NOT actual MATCHES "Verification boundary")
    message(FATAL_ERROR "Unresolved cross-file implementation lost unknown state: ${actual}")
endif()
run(2 inspect "${FIXTURES}/safe" "${FIXTURES}/safe/a.ll" --function CrossA)
if(NOT actual MATCHES "duplicate-input")
    message(FATAL_ERROR "Repeated input not diagnosed: ${actual}")
endif()
run(2 inspect "${CONFLICTS}/flags_a.ll" "${CONFLICTS}/flags_b.ll" --function FlagA)
if(NOT actual MATCHES "module-link" OR NOT actual MATCHES "wchar_size")
    message(FATAL_ERROR "LLVM conflict should be a caught error, not process termination: ${actual}")
endif()
