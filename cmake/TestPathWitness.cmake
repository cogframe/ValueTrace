execute_process(COMMAND "${PROGRAM}" solve "${INPUT}" --function C --param-name length --op ugt --value 4096 --up 2
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "SAT")
    message(FATAL_ERROR "No witness: ${result}\n${output}\n${error}")
endif()
string(REGEX MATCH "Boundary input A\\.input i32 unsigned=([0-9]+)" input_match "${output}")
if(NOT input_match)
    message(FATAL_ERROR "Boundary input missing: ${output}")
endif()
set(input "${CMAKE_MATCH_1}")
string(REGEX MATCH "Target bit pattern \\(unsigned decimal\\): ([0-9]+)" target_match "${output}")
if(NOT target_match)
    message(FATAL_ERROR "Target value missing: ${output}")
endif()
set(expected "${CMAKE_MATCH_1}")
execute_process(COMMAND "${REPLAY}" "${input}" RESULT_VARIABLE result OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "Witness replay differs: input=${input}, model=${expected}, actual=${actual}")
endif()
