foreach(variant IN ITEMS safe unsafe)
    if(variant STREQUAL "safe")
        set(guard 1)
    else()
        set(guard 0)
    endif()
    file(MAKE_DIRECTORY "${OUTPUT}/${variant}")
    foreach(unit IN ITEMS a b c reference)
        if(unit STREQUAL "b")
            set(destination "${OUTPUT}/${variant}/b.bc")
        elseif(unit STREQUAL "reference")
            set(destination "${OUTPUT}/reference_${variant}.ll")
        else()
            set(destination "${OUTPUT}/${variant}/${unit}.ll")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DVT_CLANG=${CLANG}" "-DVT_OPT=${OPT}"
            "-DVT_SOURCE=${SOURCE}/${unit}.cpp" "-DVT_OUTPUT=${destination}"
            "-DVT_DEFINE=GUARDED=${guard}" -P "${PREPARE_SCRIPT}"
            RESULT_VARIABLE code ERROR_VARIABLE error)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Multifile fixture ${unit}/${variant} failed: ${error}")
        endif()
    endforeach()
endforeach()
