function(run function_name)
    execute_process(COMMAND "${PROGRAM}" verify "${INPUT}" --function "${function_name}"
        --param 0 --up 0 --down 0 ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Warnings must not fail execution: ${code}: ${error}")
    endif()
    set(actual "${output}" PARENT_SCOPE)
endfunction()
run(raw64 --show-status none)
if(actual MATCHES "Warning: ArithmeticRisk" OR NOT actual MATCHES "total=2 shown=0 hidden=2" OR
   NOT actual MATCHES "status=boundary-triggerable total=2 shown=0 hidden=2")
    message(FATAL_ERROR "Hidden verification lost candidates/results: ${actual}")
endif()
run(raw64)
if(NOT actual MATCHES "feasibility=boundary-triggerable" OR NOT actual MATCHES "ir-value=poison")
    message(FATAL_ERROR "Default filter lost triggerable witness: ${actual}")
endif()
run(memory --report-level 3)
if(NOT actual MATCHES "feasibility=unknown" OR NOT actual MATCHES "status=unknown total=2 shown=2 hidden=0")
    message(FATAL_ERROR "Unselected entry memory must remain unknown: ${actual}")
endif()
run(memory --show-status none)
if(actual MATCHES "Warning: ArithmeticRisk" OR NOT actual MATCHES "Verification boundary" OR
   NOT actual MATCHES "status=unknown total=2 shown=0 hidden=2")
    message(FATAL_ERROR "Display filter hid verification boundaries: ${actual}")
endif()
run(guarded --report-level 5)
if(NOT actual MATCHES "feasibility=scoped-unreachable" OR NOT actual MATCHES "status=source-confirmed total=0")
    message(FATAL_ERROR "Guarded risk state or source closure incorrect: ${actual}")
endif()
