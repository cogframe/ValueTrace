execute_process(COMMAND "${PROGRAM}" trace "${INPUT}" --function "${FUNCTION}"
    --param-name input --up 0 --down 0 --report-level 5
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(INPUT MATCHES "\\.ll$")
    file(READ "${INPUT}" ir)
    if(ir MATCHES "[ =]alloca ")
        message(FATAL_ERROR "${FUNCTION}: promotable scalar alloca remains after mem2reg/sroa")
    endif()
endif()
if(NOT code EQUAL 0)
    message(FATAL_ERROR "${FUNCTION} trace failed: ${error}\n${output}")
endif()
if(NOT output MATCHES "Source parameter 'input' -> LLVM argument 0")
    message(FATAL_ERROR "${FUNCTION}: source parameter mapping lost\n${output}")
endif()
if(NOT output MATCHES "opcode=add" OR NOT output MATCHES "#[0-9]+ -> #[0-9]+ operand=")
    message(FATAL_ERROR "${FUNCTION}: local variable propagation is disconnected\n${output}")
endif()
if(FUNCTION STREQUAL "LocalNarrow")
    set(expected "opcode=trunc")
elseif(FUNCTION STREQUAL "LocalBranch")
    set(expected "opcode=phi")
else()
    set(expected "opcode=mul")
endif()
if(NOT output MATCHES "${expected}")
    message(FATAL_ERROR "${FUNCTION}: missing ${expected}\n${output}")
endif()
