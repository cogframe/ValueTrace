# Inputs: VT_CLANG, VT_OPT, VT_SOURCE or VT_SOURCES (pipe separated),
# VT_OUTPUT, optional VT_LINK_TOOL, VT_DEFINE, VT_DEBUG=OFF.
foreach(required IN ITEMS VT_CLANG VT_OPT VT_OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
if(DEFINED VT_SOURCES AND NOT "${VT_SOURCES}" STREQUAL "")
    string(REPLACE "|" ";" sources "${VT_SOURCES}")
elseif(DEFINED VT_SOURCE AND NOT "${VT_SOURCE}" STREQUAL "")
    set(sources "${VT_SOURCE}")
else()
    message(FATAL_ERROR "Provide VT_SOURCE or VT_SOURCES")
endif()
list(LENGTH sources source_count)
if(source_count GREATER 1 AND NOT VT_LINK)
    message(FATAL_ERROR "Multiple sources require VT_LINK=ON; run once per source for separate modules")
endif()
if(VT_LINK AND (NOT DEFINED VT_LINK_TOOL OR "${VT_LINK_TOOL}" STREQUAL ""))
    message(FATAL_ERROR "VT_LINK_TOOL is required when VT_LINK=ON")
endif()
if(VT_DEBUG STREQUAL "OFF")
    set(debug_flag -g0)
else()
    set(debug_flag -g)
endif()
get_filename_component(output_dir "${VT_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
set(prepared)
set(temporaries)
set(index 0)
foreach(source IN LISTS sources)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "Source does not exist: ${source}")
    endif()
    get_filename_component(source_extension "${source}" EXT)
    string(TOLOWER "${source_extension}" source_extension_lower)
    if(source_extension STREQUAL ".C" OR source_extension_lower MATCHES "^\\.(cc|cpp|cxx)$")
        set(source_language c++)
        set(source_standard -std=c++20)
    elseif(source_extension_lower STREQUAL ".c")
        set(source_language c)
        set(source_standard -std=c17)
    else()
        message(FATAL_ERROR "Unsupported source extension for ${source}; expected .c, .cc, .cpp, .cxx, or .C")
    endif()
    set(raw "${VT_OUTPUT}.${index}.raw.ll")
    set(clean "${VT_OUTPUT}.${index}.mem2reg.bc")
    if(DEFINED VT_DEFINE AND NOT "${VT_DEFINE}" STREQUAL "")
        set(define_arg "-D${VT_DEFINE}")
    else()
        set(define_arg)
    endif()
    if(DEFINED VT_EXTRA AND NOT "${VT_EXTRA}" STREQUAL "")
        string(REPLACE "|" ";" extra "${VT_EXTRA}")
    else()
        set(extra)
    endif()
    execute_process(COMMAND "${VT_CLANG}" -x "${source_language}" ${source_standard} -S -emit-llvm -O0 ${debug_flag}
        -Xclang -disable-O0-optnone -fno-inline -fno-discard-value-names
        ${define_arg} ${extra} "${source}" -o "${raw}"
        RESULT_VARIABLE code ERROR_VARIABLE error)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "clang failed for ${source}: ${error}")
    endif()
    execute_process(COMMAND "${VT_OPT}" -passes=mem2reg,sroa "${raw}" -o "${clean}"
        RESULT_VARIABLE code ERROR_VARIABLE error)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "opt failed for ${source}: ${error}")
    endif()
    list(APPEND prepared "${clean}")
    list(APPEND temporaries "${raw}" "${clean}")
    math(EXPR index "${index} + 1")
endforeach()
get_filename_component(extension "${VT_OUTPUT}" EXT)
if(extension STREQUAL ".ll")
    set(text_flag -S)
elseif(extension STREQUAL ".bc")
    set(text_flag)
else()
    message(FATAL_ERROR "VT_OUTPUT must end in .ll or .bc")
endif()
if(VT_LINK)
    execute_process(COMMAND "${VT_LINK_TOOL}" ${text_flag} ${prepared} -o "${VT_OUTPUT}"
        RESULT_VARIABLE code ERROR_VARIABLE error)
else()
    execute_process(COMMAND "${VT_OPT}" ${text_flag} -passes=verify "${prepared}" -o "${VT_OUTPUT}"
        RESULT_VARIABLE code ERROR_VARIABLE error)
endif()
if(NOT code EQUAL 0)
    message(FATAL_ERROR "final IR emission failed: ${error}")
endif()
file(REMOVE ${temporaries})
